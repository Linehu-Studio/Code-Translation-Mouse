#include <winver.h>

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Linehu-Studio"
            VALUE "FileDescription", "Code Translation Mouse"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "CodeTranslationMouse"
            VALUE "LegalCopyright", "Copyright (c) 2026 Linehu-Studio"
            VALUE "OriginalFilename", "CodeTranslationMouse.exe"
            VALUE "ProductName", "Code Translation Mouse"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

DICTIONARY RCDATA "dictionary.txt"
